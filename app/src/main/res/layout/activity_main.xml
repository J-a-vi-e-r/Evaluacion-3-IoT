<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/canvas">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_leaf" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_0" android:textSize="20sp" android:textColor="@color/forest" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_1" android:textSize="10sp" android:textColor="@color/muted" android:letterSpacing="0.14" />
                </LinearLayout>
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="16dp" />
            <ImageView android:layout_width="match_parent" android:layout_height="100dp" android:src="@drawable/illustration_greenhouse" android:importantForAccessibility="no" />
            <Space android:layout_width="1dp" android:layout_height="16dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_2" android:textSize="30sp" android:textColor="@color/forest" android:fontFamily="sans-serif-medium" android:lineSpacingExtra="0dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_3" android:textSize="15sp" android:textColor="@color/muted" android:layout_marginTop="10dp" android:lineSpacingExtra="4dp" />
            <Space android:layout_width="1dp" android:layout_height="16dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_4" android:textSize="13sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" android:layout_marginBottom="8dp" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/copy_5" app:boxBackgroundMode="outline" app:boxBackgroundColor="@color/white" app:boxStrokeColor="@color/forest" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:id="@+id/etEmail" android:inputType="textEmailAddress" android:singleLine="true" android:textSize="15sp" android:textColor="@color/ink" android:padding="16dp" android:autofillHints="emailAddress" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="1dp" android:layout_height="16dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_6" android:textSize="13sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" android:layout_marginBottom="8dp" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/copy_7" app:boxBackgroundMode="outline" app:boxBackgroundColor="@color/white" app:boxStrokeColor="@color/forest" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:id="@+id/etPassword" android:inputType="textPassword" android:singleLine="true" android:textSize="15sp" android:textColor="@color/ink" android:padding="16dp" android:autofillHints="password" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="1dp" android:layout_height="16dp" />
            <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:id="@+id/btnLogin" android:text="@string/copy_8" android:textAllCaps="false" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="@color/white" app:backgroundTint="@color/forest" app:cornerRadius="16dp" android:insetTop="0dp" android:insetBottom="0dp" />
            <Space android:layout_width="1dp" android:layout_height="8dp" />
            <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:id="@+id/tvRegistrarse" android:text="@string/copy_9" android:textAllCaps="false" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="@color/forest" app:backgroundTint="@color/sage" app:cornerRadius="16dp" android:insetTop="0dp" android:insetBottom="0dp" />
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:id="@+id/btnDemo" android:text="@string/copy_10" android:textAllCaps="false" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="@color/forest" app:backgroundTint="@color/sage" app:cornerRadius="16dp" android:insetTop="0dp" android:insetBottom="0dp" app:strokeWidth="1dp" app:strokeColor="@color/line" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_11" android:textSize="12sp" android:textColor="@color/muted" android:gravity="center" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnRecuperar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Olvidé mi contraseña" android:textAllCaps="false" style="@style/Widget.Material3.Button.TextButton" /><com.google.android.material.button.MaterialButton android:id="@+id/btnConfirmarCuenta" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Confirmar mi correo" android:textAllCaps="false" style="@style/Widget.Material3.Button.TextButton" /><com.google.android.material.button.MaterialButton android:id="@+id/btnPrivacidad" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Privacidad y uso de datos" android:textAllCaps="false" style="@style/Widget.Material3.Button.TextButton" /></LinearLayout>
    </ScrollView>
</LinearLayout>