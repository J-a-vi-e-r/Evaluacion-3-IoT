<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/canvas">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <androidx.appcompat.widget.AppCompatImageButton android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/btnVolver" android:background="@drawable/bg_icon" android:padding="13dp" android:src="@drawable/ic_back" android:contentDescription="@string/copy_12" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/copy_13" android:textSize="20sp" android:textColor="@color/forest" android:layout_weight="1" android:layout_marginStart="12dp" android:fontFamily="sans-serif-medium" />
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="32dp" />
            <ImageView android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_leaf" android:importantForAccessibility="no" />
            <Space android:layout_width="1dp" android:layout_height="20dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_14" android:textSize="30sp" android:textColor="@color/forest" android:fontFamily="sans-serif-medium" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_15" android:textSize="14sp" android:textColor="@color/muted" android:layout_marginTop="10dp" />
            <Space android:layout_width="1dp" android:layout_height="28dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_16" android:textSize="13sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" android:layout_marginBottom="8dp" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/copy_17" app:boxBackgroundMode="outline" app:boxBackgroundColor="@color/white" app:boxStrokeColor="@color/forest" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:id="@+id/etRegEmail" android:inputType="textEmailAddress" android:singleLine="true" android:textSize="15sp" android:textColor="@color/ink" android:padding="16dp" android:autofillHints="emailAddress" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="1dp" android:layout_height="16dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_18" android:textSize="13sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" android:layout_marginBottom="8dp" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/copy_19" app:boxBackgroundMode="outline" app:boxBackgroundColor="@color/white" app:boxStrokeColor="@color/forest" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:id="@+id/etRegPassword" android:inputType="textPassword" android:singleLine="true" android:textSize="15sp" android:textColor="@color/ink" android:padding="16dp" android:autofillHints="newPassword" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="1dp" android:layout_height="16dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_20" android:textSize="13sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" android:layout_marginBottom="8dp" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/copy_21" app:boxBackgroundMode="outline" app:boxBackgroundColor="@color/white" app:boxStrokeColor="@color/forest" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:id="@+id/etRegConfirmPassword" android:inputType="textPassword" android:singleLine="true" android:textSize="15sp" android:textColor="@color/ink" android:padding="16dp" android:autofillHints="newPassword" android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="1dp" android:layout_height="16dp" />
            <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/checkPrivacidad" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="He leído el aviso de privacidad del prototipo." /><com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:id="@+id/btnRegistrarUsuario" android:text="@string/copy_22" android:textAllCaps="false" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="@color/white" app:backgroundTint="@color/forest" app:cornerRadius="16dp" android:insetTop="0dp" android:insetBottom="0dp" />
            <Space android:layout_width="1dp" android:layout_height="18dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_sage" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_23" android:textSize="13sp" android:textColor="@color/forest" android:fontFamily="sans-serif-medium" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_24" android:textSize="12sp" android:textColor="@color/muted" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnPrivacidad" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Privacidad y uso de datos" android:textAllCaps="false" style="@style/Widget.Material3.Button.TextButton" /></LinearLayout>
    </ScrollView>
</LinearLayout>